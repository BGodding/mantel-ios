<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to Secrets/Secrets.plist (git-ignored) and set your own values.
  Both files are bundled; Secrets.plist wins when present, otherwise this
  example is used so a fresh clone still builds and runs.

  MANTEL_BASE_URL             Nextcloud origin the app talks to by default.
  MANTEL_ALLOWED_HOST_SUFFIX  A Remote Config `server_base_url` is only accepted
                              when its host == this value or ends in ".<value>".
                              Keep it as tight as your DNS allows.
-->
<plist version="1.0">
<dict>
	<key>MANTEL_BASE_URL</key>
	<string>https://nextcloud.example.com</string>
	<key>MANTEL_ALLOWED_HOST_SUFFIX</key>
	<string>example.com</string>
</dict>
</plist>
